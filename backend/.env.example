# Application
APP_NAME=SalonSaaS
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - PostgreSQL
# For Supabase: use the "Transaction pooler" host/port from
# Project Settings > Database > Connection string, and set DB_SSL_REQUIRE=True
# and DB_PGBOUNCER=True (the pooler doesn't support asyncpg's prepared statements).
# On Vercel, also drop DB_POOL_SIZE/DB_MAX_OVERFLOW way down (e.g. 1 / 0) — each
# serverless invocation opens its own pool, and Supabase's pooler is what
# actually multiplexes connections across them.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salon_saas
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_SSL_REQUIRE=False
DB_PGBOUNCER=False

# Required in production so /api/v1/cron/run can't be triggered by anyone
# else — Vercel sends this automatically as a Bearer token for cron requests.
# Generate any long random string and set the same value in Vercel env vars.
CRON_SECRET=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# Email (SMTP)
MAIL_USERNAME=noreply@salonsaas.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@salonsaas.com
MAIL_FROM_NAME=SalonSaaS
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# SMS - Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# File Storage - Azure Blob / S3
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=salon-saas-files
AWS_REGION=us-east-1

# Local file storage (for development)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Frontend URL (for CORS + email links)
FRONTEND_URL=http://localhost:3000

# Loyalty Points Config
LOYALTY_POINTS_PER_CURRENCY=1
LOYALTY_REDEEM_RATE=0.01

# Card terminal / payment gateway (leave blank for manual card recording)
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_ENV=sandbox

# Stripe (get test keys at https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Super Admin
SUPER_ADMIN_EMAIL=admin@salonsaas.com
SUPER_ADMIN_PASSWORD=Admin@12345
